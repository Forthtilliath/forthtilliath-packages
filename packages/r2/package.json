{
  "name": "@forthtilliath/r2",
  "version": "0.1.0",
  "description": "Direct browser-to-bucket uploads for Cloudflare R2 (or any S3-compatible storage) via presigned URLs.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Forthtilliath/forthtilliath-packages.git",
    "directory": "packages/r2"
  },
  "homepage": "https://github.com/Forthtilliath/forthtilliath-packages/tree/main/packages/r2#readme",
  "bugs": "https://github.com/Forthtilliath/forthtilliath-packages/issues",
  "scripts": {
    "dev": "tsc --watch -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./server": "./dist/server.js"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1070.0",
    "@aws-sdk/s3-request-presigner": "^3.1070.0",
    "@forthtilliath/eslint-config": "workspace:*",
    "@forthtilliath/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
