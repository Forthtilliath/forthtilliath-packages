{
  "name": "@forthtilliath/expo-release-updates",
  "version": "0.4.7",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Forthtilliath/forthtilliath-packages.git",
    "directory": "packages/expo-release-updates"
  },
  "homepage": "https://github.com/Forthtilliath/forthtilliath-packages/tree/main/packages/expo-release-updates#readme",
  "bugs": "https://github.com/Forthtilliath/forthtilliath-packages/issues",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc --watch -p tsconfig.build.json",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "peerDependencies": {
    "expo-file-system": ">=54.0.0",
    "expo-intent-launcher": ">=12.0.0"
  },
  "dependencies": {
    "@forthtilliath/ts-kit": "workspace:^"
  },
  "devDependencies": {
    "@forthtilliath/eslint-config": "workspace:*",
    "@forthtilliath/test-kit": "workspace:*",
    "@forthtilliath/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "expo-file-system": "~57.0.2",
    "expo-intent-launcher": "~57.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
