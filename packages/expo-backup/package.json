{
  "name": "@forthtilliath/expo-backup",
  "version": "0.2.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Forthtilliath/forthtilliath-packages.git",
    "directory": "packages/expo-backup"
  },
  "homepage": "https://github.com/Forthtilliath/forthtilliath-packages/tree/main/packages/expo-backup#readme",
  "bugs": "https://github.com/Forthtilliath/forthtilliath-packages/issues",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc --watch -p tsconfig.build.json",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "dependencies": {
    "@forthtilliath/backup-crypto": "workspace:^"
  },
  "peerDependencies": {
    "@react-native-google-signin/google-signin": ">=16.0.0",
    "expo-crypto": ">=57.0.0",
    "expo-file-system": ">=57.0.0",
    "expo-secure-store": ">=57.0.0",
    "expo-sharing": ">=57.0.0",
    "react-native": ">=0.81"
  },
  "peerDependenciesMeta": {
    "@react-native-google-signin/google-signin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@forthtilliath/eslint-config": "workspace:*",
    "@forthtilliath/expo-test-kit": "workspace:*",
    "@forthtilliath/test-kit": "workspace:*",
    "@forthtilliath/typescript-config": "workspace:*",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "react-native": "0.86.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
