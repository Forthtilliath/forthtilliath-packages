{
  "name": "@forthtilliath/react-native-kit",
  "version": "0.20.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Forthtilliath/forthtilliath-packages.git",
    "directory": "packages/react-native-kit"
  },
  "homepage": "https://github.com/Forthtilliath/forthtilliath-packages/tree/main/packages/react-native-kit#readme",
  "bugs": "https://github.com/Forthtilliath/forthtilliath-packages/issues",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc --watch -p tsconfig.build.json",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "size": "size-limit"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "dependencies": {
    "@forthtilliath/ts-kit": "workspace:^"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=15.0.0",
    "@forthtilliath/expo-release-updates-ui": ">=0.4.1",
    "expo-calendar": ">=54.0.0",
    "expo-file-system": ">=54.0.0",
    "expo-haptics": ">=54.0.0",
    "expo-image-manipulator": ">=54.0.0",
    "expo-image-picker": ">=54.0.0",
    "expo-sharing": ">=54.0.0",
    "expo-speech-recognition": ">=1.0.0",
    "react": ">=19",
    "react-native": ">=0.81",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-view-shot": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@expo/vector-icons": {
      "optional": true
    },
    "@forthtilliath/expo-release-updates-ui": {
      "optional": true
    },
    "expo-calendar": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "expo-image-manipulator": {
      "optional": true
    },
    "expo-image-picker": {
      "optional": true
    },
    "expo-sharing": {
      "optional": true
    },
    "expo-speech-recognition": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-view-shot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@forthtilliath/eslint-config": "workspace:*",
    "@forthtilliath/expo-release-updates-ui": "workspace:^",
    "@forthtilliath/typescript-config": "workspace:*",
    "@size-limit/file": "catalog:",
    "@types/react": "catalog:",
    "@types/react-test-renderer": "^19.1.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "expo-calendar": "~57.0.5",
    "expo-file-system": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.9",
    "expo-sharing": "~57.0.23",
    "expo-speech-recognition": "^56.0.1",
    "react": "catalog:",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "size-limit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "size-limit": [
    {
      "name": "dist (all modules, brotli)",
      "path": "dist/**/*.js",
      "limit": "47 KB"
    }
  ]
}
