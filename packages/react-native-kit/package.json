{
  "name": "@forthtilliath/react-native-kit",
  "version": "0.14.4",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Forthtilliath/forthtilliath-packages.git",
    "directory": "packages/react-native-kit"
  },
  "homepage": "https://github.com/Forthtilliath/forthtilliath-packages/tree/main/packages/react-native-kit#readme",
  "bugs": "https://github.com/Forthtilliath/forthtilliath-packages/issues",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "tsc --watch -p tsconfig.build.json",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "size": "size-limit"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "dependencies": {
    "@forthtilliath/expo-release-updates-ui": "workspace:*",
    "@forthtilliath/ts-kit": "workspace:*"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=15.0.0",
    "expo-image-picker": ">=54.0.0",
    "expo-speech-recognition": ">=1.0.0",
    "react": ">=19",
    "react-native": ">=0.81",
    "react-native-gesture-handler": ">=2.20.0"
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@forthtilliath/eslint-config": "workspace:*",
    "@forthtilliath/typescript-config": "workspace:*",
    "@size-limit/file": "^11.2.0",
    "@types/react": "catalog:",
    "@types/react-test-renderer": "^19.1.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "catalog:",
    "expo-image-picker": "~57.0.9",
    "expo-speech-recognition": "^56.0.1",
    "react": "catalog:",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-test-renderer": "19.2.3",
    "size-limit": "^11.2.0",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "name": "dist (all modules, brotli)",
      "path": "dist/**/*.js",
      "limit": "30 KB"
    }
  ]
}
