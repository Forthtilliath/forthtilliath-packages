{
  "name": "@forthtilliath/supabase-test-kit",
  "version": "0.0.0",
  "description": "Integration tests against a local Supabase: guarded test clients, throwaway users, schema security rules and production schema drift detection.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Forthtilliath/forthtilliath-packages.git",
    "directory": "packages/supabase-test-kit"
  },
  "homepage": "https://github.com/Forthtilliath/forthtilliath-packages/tree/main/packages/supabase-test-kit#readme",
  "bugs": "https://github.com/Forthtilliath/forthtilliath-packages/issues",
  "scripts": {
    "dev": "tsc --watch -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "sql"
  ],
  "bin": {
    "supabase-db-drift": "./dist/cli/db-drift.js",
    "supabase-gen-types": "./dist/cli/gen-types.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./pg": "./dist/pg.js",
    "./vitest": "./dist/vitest.js",
    "./sql/*": "./sql/*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "pg": "^8.0.0",
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@forthtilliath/eslint-config": "workspace:*",
    "@forthtilliath/typescript-config": "workspace:*",
    "@supabase/supabase-js": "^2.105.1",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "pg": "^8.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
