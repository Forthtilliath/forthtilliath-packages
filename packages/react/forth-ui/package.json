{
  "name": "@forthtilliath/forth-ui",
  "version": "0.3.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Forthtilliath/forthtilliath-packages.git",
    "directory": "packages/react/forth-ui"
  },
  "homepage": "https://github.com/Forthtilliath/forthtilliath-packages/tree/main/packages/react/forth-ui#readme",
  "bugs": "https://github.com/Forthtilliath/forthtilliath-packages/issues",
  "scripts": {
    "lint": "eslint . --max-warnings 0 && node scripts/check-css-sources.js",
    "check-types": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "concurrently \"pnpm:dev:ts\" \"pnpm:dev:tw\"",
    "dev:ts": "tsc --watch",
    "dev:tw": "pnpm run build:tw --watch",
    "build": "pnpm run clean && pnpm run build:ts && pnpm run build:tw",
    "build:ts": "tsc",
    "build:tw": "tailwindcss -i ./src/styles/globals.css -o ./dist/globals.css",
    "size": "size-limit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@forthtilliath/react-kit": "workspace:^",
    "@forthtilliath/shadcn-ui": "workspace:^",
    "@forthtilliath/ts-types": "workspace:^",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "shiki": "^4.4.3"
  },
  "peerDependencies": {
    "next-themes": ">=0.4",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "next-themes": {
      "optional": true
    }
  },
  "devDependencies": {
    "@forthtilliath/eslint-config": "workspace:*",
    "@forthtilliath/typescript-config": "workspace:*",
    "@size-limit/file": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "^10.0.4",
    "eslint": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./components/*": "./dist/components/*/index.js",
    "./locale": "./dist/locale/index.js",
    "./styles/globals.css": "./dist/globals.css"
  },
  "size-limit": [
    {
      "name": "components (all, brotli)",
      "path": "dist/**/*.js",
      "limit": "70 KB"
    },
    {
      "name": "globals.css (brotli)",
      "path": "dist/globals.css",
      "limit": "20 KB"
    }
  ]
}
