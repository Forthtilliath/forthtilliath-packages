{
  "extends": "@forthtilliath/typescript-config/react.json",
  "compilerOptions": {
    // Stays on react.json's `bundler` resolution: src/ holds shadcn components
    // copied as-is, whose relative imports have no extension. The published
    // dist/ gets them added by scripts/add-dist-import-extensions.js instead.
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
