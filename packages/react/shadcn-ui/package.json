{
  "name": "@forthtilliath/shadcn-ui",
  "version": "0.4.2",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Forthtilliath/forthtilliath-packages.git",
    "directory": "packages/react/shadcn-ui"
  },
