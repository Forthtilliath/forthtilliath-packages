{
  "name": "@forthtilliath/react-kit",
  "version": "0.4.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Forthtilliath/forthtilliath-packages.git",
    "directory": "packages/react-kit"
  },
  "homepage": "https://github.com/Forthtilliath/forthtilliath-packages/tree/main/packages/react-kit#readme",
  "bugs": "https://github.com/Forthtilliath/forthtilliath-packages/issues",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc --watch -p tsconfig.build.json",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./dist/*.js"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@forthtilliath/eslint-config": "workspace:*",
    "@forthtilliath/typescript-config": "workspace:*",
    "@size-limit/file": "catalog:",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "size-limit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "size-limit": [
    {
      "name": "dist (all modules, brotli)",
      "path": "dist/**/*.js",
      "limit": "10 KB"
    }
  ]
}
