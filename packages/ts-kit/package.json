{
  "name": "@forthtilliath/ts-kit",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Forthtilliath/forthtilliath-packages.git",
    "directory": "packages/ts-kit"
  },
  "homepage": "https://github.com/Forthtilliath/forthtilliath-packages/tree/main/packages/ts-kit#readme",
  "bugs": "https://github.com/Forthtilliath/forthtilliath-packages/issues",
  "scripts": {
    "dev": "tsc --watch -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./dist/*.js"
  },
  "devDependencies": {
    "@forthtilliath/eslint-config": "workspace:*",
    "@forthtilliath/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "jsdom": "^29.1.1",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
