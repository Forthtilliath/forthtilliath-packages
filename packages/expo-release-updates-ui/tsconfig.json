{
  "extends": "@forthtilliath/typescript-config/react.json",
  "compilerOptions": {
    // Stays on react.json's `bundler` resolution, unlike the web packages:
    // React Native code is only ever loaded through Metro (never plain Node,
    // where `react-native` itself can't load), and NodeNext would type some
    // CJS-shipped RN packages' default exports (e.g. gesture-handler's
    // ReanimatedSwipeable) differently from what Metro actually hands over.
    // Relative imports still carry their `.js` extension, which `bundler`
    // accepts too.
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
