{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "include": ["${configDir}/**/*.ts", "${configDir}/**/*.tsx"],
  "exclude": ["${configDir}/node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "esnext"
  }
}
