    "@forthtilliath/react-kit": "workspace:*",
    "@forthtilliath/shadcn-ui": "workspace:*",
    "@forthtilliath/ts-types": "workspace:*",
    "@forthtilliath/typescript-config": "workspace:*",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/cli": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "date-fns": "^4.4.0",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "10.6.0",
    "lucide-react": "^1.31.0",
    "playwright": "^1.62.1",
    "storybook": "10.6.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
